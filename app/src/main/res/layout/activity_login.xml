<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#121B22">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chat GvG"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <EditText
        android:id="@+id/etNick"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Seu Nick"
        android:textColorHint="#8696A0"
        android:textColor="#FFFFFF"
        android:background="#1F2C34"
        android:paddingHorizontal="16dp"
        android:inputType="textPersonName"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Senha"
        android:textColorHint="#8696A0"
        android:textColor="#FFFFFF"
        android:background="#1F2C34"
        android:paddingHorizontal="16dp"
        android:inputType="textPassword"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Entrar"
        android:backgroundTint="#00A884"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Criar Nova Conta"
        android:backgroundTint="#1F2C34"
        android:textColor="#00A884"
        android:textStyle="bold" />

</LinearLayout>
